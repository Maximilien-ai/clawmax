{
  "apiVersion": "clawmax.ai/v2",
  "id": "plugin-review-notes",
  "slug": "plugin-review-notes",
  "name": "Release Review",
  "description": "Run acceptance checklists independently for each release, capture reviewer evidence and notes, and export a complete report for follow-up.",
  "version": "0.3.0-test",
  "icon": "checklist",
  "objectKind": "review-note",
  "visibility": "public",
  "enabledByDefault": true,
  "source": {
    "type": "github",
    "owner": "Maximilien-ai",
    "repo": "clawmax",
    "url": "https://github.com/Maximilien-ai/clawmax/tree/main/PLUGINS/public/clawmax-review",
    "branch": "main"
  },
  "nav": {
    "section": "plugins",
    "order": 1000,
    "label": "Review"
  },
  "capabilities": {
    "notifications": true,
    "docs": true
  },
  "labels": {
    "singular": "Check",
    "plural": "Checks"
  },
  "recordSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["release", "area", "outcome"],
    "properties": {
      "release": {
        "type": "string",
        "title": "Release"
      },
      "area": {
        "type": "string",
        "title": "Area",
        "enum": ["identity", "navigation", "plugins", "guardrails", "evals", "persistence", "responsive", "regression"],
        "default": "regression"
      },
      "completed": {
        "type": "boolean",
        "title": "Completed",
        "default": false
      },
      "outcome": {
        "type": "string",
        "title": "Outcome",
        "enum": ["pending", "passed", "failed", "blocked"],
        "default": "pending"
      },
      "notes": {
        "type": "string",
        "title": "Notes",
        "format": "textarea"
      },
      "owner": {
        "type": "string",
        "title": "Owner"
      },
      "reviewReason": {
        "type": "string",
        "title": "Why independent review is needed",
        "enum": ["human-judgment", "external-environment"]
      },
      "evidence": {
        "type": "array",
        "title": "Evidence",
        "items": { "type": "string" },
        "default": []
      },
      "verifiedBy": {
        "type": "array",
        "title": "Previously verified by",
        "description": "Tester, environment, and date from an earlier exported review.",
        "items": { "type": "string" },
        "default": []
      }
    }
  },
  "ui": {
    "form": {
      "order": ["release", "area", "reviewReason", "completed", "outcome", "notes", "owner", "evidence", "verifiedBy"]
    },
    "list": {
      "fields": ["area", "reviewReason", "outcome", "completed", "owner", "evidence", "verifiedBy"],
      "groupBy": "release",
      "checkField": "completed"
    }
  }
}
