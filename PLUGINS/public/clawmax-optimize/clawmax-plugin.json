{
  "apiVersion": "clawmax.ai/v2",
  "id": "clawmax-optimize",
  "slug": "clawmax-optimize",
  "name": "Optimize",
  "description": "Plan workspace, workflow, and agent token and cost budgets, then compare model and schedule recommendations against current usage.",
  "version": "0.4.4",
  "icon": "activity",
  "objectKind": "optimization-plan",
  "visibility": "public",
  "enabledByDefault": false,
  "source": {
    "type": "github",
    "owner": "Maximilien-ai",
    "repo": "clawmax",
    "url": "https://github.com/Maximilien-ai/clawmax/tree/main/PLUGINS/public/clawmax-optimize",
    "branch": "main"
  },
  "nav": {
    "section": "plugins",
    "order": 30,
    "label": "Optimize"
  },
  "capabilities": {
    "notifications": true,
    "docs": true,
    "agents": true,
    "workflows": true
  },
  "labels": {
    "singular": "Plan",
    "plural": "Plans"
  },
  "recordSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["scope", "optimizationGoal", "monthlyTokenBudget", "monthlyCostBudget", "status"],
    "properties": {
      "scope": {
        "type": "string",
        "title": "Optimize",
        "enum": ["workflow", "agent", "workspace"],
        "default": "workflow"
      },
      "targetIds": {
        "type": "array",
        "title": "Targets",
        "description": "Workflow or agent IDs covered by this plan.",
        "items": { "type": "string" },
        "default": []
      },
      "optimizationGoal": {
        "type": "string",
        "title": "Priority",
        "enum": ["balanced", "quality", "speed", "tokens", "cost"],
        "default": "balanced"
      },
      "monthlyTokenBudget": {
        "type": "integer",
        "title": "Monthly token budget",
        "control": "slider",
        "minimum": 0,
        "maximum": 10000000,
        "step": 50000,
        "default": 1000000
      },
      "monthlyCostBudget": {
        "type": "number",
        "title": "Monthly cost budget",
        "control": "slider",
        "minimum": 0,
        "maximum": 1000,
        "step": 1,
        "default": 25
      },
      "perRunTokenBudget": {
        "type": "integer",
        "title": "Token budget per run",
        "control": "slider",
        "minimum": 0,
        "maximum": 1000000,
        "step": 5000,
        "default": 25000
      },
      "perRunCostBudget": {
        "type": "number",
        "title": "Cost budget per run",
        "control": "slider",
        "minimum": 0,
        "maximum": 100,
        "step": 0.25,
        "default": 1
      },
      "maximumRunDurationSeconds": {
        "type": "integer",
        "title": "Maximum run duration (seconds)",
        "control": "slider",
        "minimum": 1,
        "maximum": 86400,
        "step": 30,
        "default": 300
      },
      "minimumQualityScore": {
        "type": "number",
        "title": "Minimum quality score",
        "description": "Quality floor from a representative eval; Optimize does not measure or enforce it.",
        "control": "slider",
        "minimum": 0,
        "maximum": 100,
        "step": 1,
        "default": 80
      },
      "currentTokens": {
        "type": "integer",
        "title": "Current monthly tokens",
        "default": 0
      },
      "currentCost": {
        "type": "number",
        "title": "Current monthly cost",
        "default": 0
      },
      "recommendedModel": {
        "type": "string",
        "title": "Recommended model"
      },
      "automaticModelSelection": {
        "type": "boolean",
        "title": "Recommend automatic model selection",
        "description": "Propose the agent's automatic runtime-compatible model selection setting.",
        "default": false
      },
      "modelPriority": {
        "type": "string",
        "title": "Automatic model priority",
        "enum": ["quality", "balanced", "cost"],
        "default": "balanced"
      },
      "recommendedSchedule": {
        "type": "string",
        "title": "Recommended schedule"
      },
      "status": {
        "type": "string",
        "title": "Status",
        "enum": ["draft", "recommended", "applied"],
        "default": "draft"
      },
      "rationale": {
        "type": "string",
        "title": "Recommendation",
        "format": "textarea"
      }
    }
  },
  "ui": {
    "form": {
      "order": ["scope", "targetIds", "optimizationGoal", "monthlyTokenBudget", "monthlyCostBudget", "perRunTokenBudget", "perRunCostBudget", "maximumRunDurationSeconds", "minimumQualityScore", "currentTokens", "currentCost", "automaticModelSelection", "modelPriority", "recommendedModel", "recommendedSchedule", "status", "rationale"]
    },
    "list": {
      "fields": ["scope", "targetIds", "optimizationGoal", "monthlyTokenBudget", "monthlyCostBudget", "automaticModelSelection", "modelPriority", "recommendedModel", "status"]
    }
  }
}
