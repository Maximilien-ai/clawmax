{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawmax.ai/schemas/plugin-manifest.schema.json",
  "title": "ClawMax Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "name",
    "description",
    "version",
    "icon",
    "objectKind",
    "visibility",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "icon": {
      "type": "string",
      "minLength": 1
    },
    "objectKind": {
      "type": "string",
      "enum": ["guardrail", "eval"]
    },
    "visibility": {
      "type": "string",
      "enum": ["private", "public"]
    },
    "enabledByDefault": {
      "type": "boolean"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "owner", "repo", "url"],
      "properties": {
        "type": {
          "type": "string",
          "const": "github"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "branch": {
          "type": "string"
        }
      }
    },
    "nav": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "order": {
          "type": "number"
        },
        "section": {
          "type": "string",
          "const": "plugins"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notifications": { "type": "boolean" },
        "docs": { "type": "boolean" },
        "agents": { "type": "boolean" },
        "workflows": { "type": "boolean" },
        "communications": { "type": "boolean" }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "singular": { "type": "string" },
        "plural": { "type": "string" }
      }
    }
  }
}
