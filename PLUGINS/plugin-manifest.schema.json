{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawmax.ai/schemas/plugin-manifest.schema.json",
  "title": "ClawMax Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "name",
    "description",
    "version",
    "icon",
    "objectKind",
    "visibility",
    "source"
  ],
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": ["clawmax.ai/v1", "clawmax.ai/v2"]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "icon": {
      "type": "string",
      "minLength": 1
    },
    "objectKind": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "visibility": {
      "type": "string",
      "enum": ["private", "public"]
    },
    "enabledByDefault": {
      "type": "boolean"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "owner", "repo", "url"],
      "properties": {
        "type": {
          "type": "string",
          "const": "github"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "branch": {
          "type": "string"
        }
      }
    },
    "nav": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "order": {
          "type": "number"
        },
        "section": {
          "type": "string",
          "const": "plugins"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notifications": { "type": "boolean" },
        "docs": { "type": "boolean" },
        "agents": { "type": "boolean" },
        "workflows": { "type": "boolean" },
        "communications": { "type": "boolean" }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "singular": { "type": "string" },
        "plural": { "type": "string" }
      }
    },
    "recordSchema": {
      "$ref": "#/$defs/recordSchema"
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "form": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "order": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            }
          }
        },
        "list": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fields": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "apiVersion": { "const": "clawmax.ai/v2" } },
        "required": ["apiVersion"]
      },
      "then": { "required": ["recordSchema"] },
      "else": {
        "properties": { "objectKind": { "enum": ["guardrail", "eval"] } }
      }
    }
  ],
  "$defs": {
    "recordSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "properties"],
      "properties": {
        "type": { "const": "object" },
        "required": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "additionalProperties": { "const": false },
        "properties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/fieldSchema" }
        }
      }
    },
    "fieldSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title"],
      "properties": {
        "type": { "enum": ["string", "number", "integer", "boolean", "array"] },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "default": {},
        "enum": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "format": { "enum": ["text", "textarea", "date", "uri"] },
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "string" } }
        }
      }
    }
  }
}
