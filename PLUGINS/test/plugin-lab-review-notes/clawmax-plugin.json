{
  "apiVersion": "clawmax.ai/v2",
  "id": "plugin-lab-review-notes",
  "slug": "plugin-lab-review-notes",
  "name": "Release Review",
  "description": "Keep acceptance checklists separated by release and preserve their results as release history.",
  "version": "0.2.0-test",
  "icon": "docs",
  "objectKind": "review-note",
  "visibility": "private",
  "enabledByDefault": false,
  "source": {
    "type": "github",
    "owner": "Maximilien-ai",
    "repo": "clawmax",
    "url": "https://github.com/Maximilien-ai/clawmax/tree/main/PLUGINS/test/plugin-lab-review-notes",
    "branch": "main"
  },
  "nav": {
    "section": "plugins",
    "order": 30,
    "label": "Review"
  },
  "capabilities": {
    "notifications": true,
    "docs": true
  },
  "labels": {
    "singular": "Check",
    "plural": "Checks"
  },
  "recordSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["release", "area", "outcome", "notes"],
    "properties": {
      "release": {
        "type": "string",
        "title": "Release"
      },
      "area": {
        "type": "string",
        "title": "Area",
        "enum": ["identity", "navigation", "plugins", "guardrails", "evals", "persistence", "responsive", "regression"],
        "default": "regression"
      },
      "completed": {
        "type": "boolean",
        "title": "Completed",
        "default": false
      },
      "outcome": {
        "type": "string",
        "title": "Outcome",
        "enum": ["pending", "passed", "failed", "blocked"],
        "default": "pending"
      },
      "notes": {
        "type": "string",
        "title": "Notes",
        "format": "textarea"
      },
      "owner": {
        "type": "string",
        "title": "Owner"
      },
      "evidence": {
        "type": "array",
        "title": "Evidence",
        "items": { "type": "string" },
        "default": []
      }
    }
  },
  "ui": {
    "form": {
      "order": ["release", "area", "completed", "outcome", "notes", "owner", "evidence"]
    },
    "list": {
      "fields": ["area", "outcome", "completed", "owner", "evidence"],
      "groupBy": "release",
      "checkField": "completed"
    }
  }
}
