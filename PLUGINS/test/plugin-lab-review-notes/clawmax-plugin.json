  "description": "A dormant synthetic plugin that validates the generic 2.0 record contract.",
  "version": "0.2.0-test",
  "icon": "docs",
  "objectKind": "review-note",
  "visibility": "private",
  "enabledByDefault": false,
  "source": {
    "type": "github",
    "owner": "Maximilien-ai",
    "repo": "clawmax",
    "url": "https://github.com/Maximilien-ai/clawmax/tree/main/PLUGINS/test/plugin-lab-review-notes",
